{
  "name": "@aether-ai/core",
  "version": "0.1.0",
  "private": true,
  "description": "Aether AI core: Digital Employee domain model and provider-agnostic AI layer",
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "test": "tsc -p tsconfig.json --outDir dist && node --test dist/__tests__/*.test.js",
    "validate": "python3 scripts/validate_repo.py && python3 scripts/validate_decisions.py",
    "test:integration": "tsc -p tsconfig.json --outDir dist && node --test --test-concurrency=1 dist/__tests__/*.integration.test.js"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "typescript": "^5.5.0"
  },
  "dependencies": {
    "@types/pg": "^8.21.0",
    "jose": "^6.2.8",
    "pg": "^8.23.0"
  }
}